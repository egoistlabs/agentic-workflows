{
  "name": "agentic-research",
  "version": "0.2.0",
  "description": "Audience-first, blind pain-point research run by an agent through staged files",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "format": "prettier --write src",
    "lint": "prettier --check src && tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli/main.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "bin": {
    "agentic-research": "dist/cli/main.js"
  }
}
