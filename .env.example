# Copy to .env in this folder. Every app reads it; all keys are optional.
# A project's own .env wins over this one, and real environment variables win over both.

# agentic-video: cloud Whisper large-v3 for transcription (uploads the audio).
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# agentic-research: extra sources. Without a key, that source is skipped and reported.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
